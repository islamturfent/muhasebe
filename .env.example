# MUH — environment configuration (copy to .env and adjust)
# Real OS environment variables always override these values.

APP_ENV=local                 # local | production
APP_DEBUG=true                # true in dev, false in production
APP_MAINTENANCE=false         # true to put the app into maintenance mode
APP_URL=http://localhost/muh  # public base URL of the app
APP_HTTPS=false               # true when served over HTTPS (production) — enables HSTS + HTTPS redirect
APP_KEY=base64:replace-with-a-random-64-char-key   # run: php bin/muh key:generate

# Database (MySQL default; use pgsql to switch to PostgreSQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=muh
DB_USERNAME=root
DB_PASSWORD=

# Security
PASSWORD_MIN_LENGTH=8

# Billing
BILLING_PROVIDER=simulated    # simulated | stripe
BILLING_WEBHOOK_SECRET=change-me
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Session cookie
SESSION_SECURE=false          # true behind HTTPS (sets the cookie Secure flag)

# Mail (SMTP relay). Leave MAIL_HOST empty to use log mode / PHP mail()
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls         # tls | ssl | none
MAIL_FROM=Hesap360 <no-reply@muh.local>

# e-Fatura integrator
EFATURA_PROVIDER=simulated    # simulated | rest (real HTTP integrator)
EFATURA_MODE=test             # test | production
EFATURA_TEST_URL=
EFATURA_PROD_URL=
EFATURA_USERNAME=
EFATURA_PASSWORD=

# Off-box / remote backup dir (mounted local dir or network drive).
# Used by `php bin/muh backup --upload`. Leave empty to skip upload.
BACKUP_REMOTE_DIR=
# Retention: keep only the newest N backups (pruned automatically on `backup`).
BACKUP_RETENTION=14
