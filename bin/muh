<?php

declare(strict_types=1);

/**
 * CLI entry point. Usage:
 *   php bin/muh migrate [--fresh]
 *   php bin/muh seed
 *   php bin/muh migrate --fresh && php bin/muh seed
 */

require __DIR__ . '/../app/bootstrap.php';

use Muh\Core\DB;
use Muh\Database\Migrator;
use Muh\Database\Seeder;

$args = $argv;
array_shift($args);
$command = $args[0] ?? 'help';

switch ($command) {
    case 'migrate':
        $fresh = in_array('--fresh', $args, true);
        if ($fresh) {
            echo "Dropping all tables (fresh)...\n";
            DB::execute('SET FOREIGN_KEY_CHECKS = 0');
            foreach (DB::select('SHOW TABLES') as $row) {
                $table = reset($row);
                DB::execute('DROP TABLE IF EXISTS `' . $table . '`');
            }
            DB::execute('SET FOREIGN_KEY_CHECKS = 1');
            echo "Dropped.\n";
        }
        (new Migrator())->run(dirname(__DIR__) . '/database/migrations');
        echo "Migration complete.\n";
        break;

    case 'seed':
        (new Seeder())->run(dirname(__DIR__) . '/database/seeders');
        echo "Seed complete.\n";
        break;

    case 'drop':
        DB::execute('SET FOREIGN_KEY_CHECKS = 0');
        foreach (DB::select('SHOW TABLES') as $row) {
            $table = reset($row);
            DB::execute('DROP TABLE IF EXISTS `' . $table . '`');
        }
        DB::execute('SET FOREIGN_KEY_CHECKS = 1');
        echo "All tables dropped.\n";
        break;

    case 'test':
        $results = (new \Muh\Core\AppTester())->run();
        $pass = 0;
        $fail = 0;
        foreach ($results as $r) {
            $mark = $r['ok'] ? 'PASS' : 'FAIL';
            $r['ok'] ? $pass++ : $fail++;
            echo "  [{$mark}] {$r['name']} — {$r['detail']}\n";
        }
        echo "\n{$pass} passed, {$fail} failed\n";
        exit($fail > 0 ? 1 : 0);
        break;

    case 'test:email-template':
        // Focused gate (B3): branded, localized e-mail template rendering.
        $ok = true;
        $checks = [];
        $tr = \Muh\Services\EmailTemplateService::layout('tr', 'Deneme', '<p>Merhaba</p>');
        $en = \Muh\Services\EmailTemplateService::layout('en', 'Test', '<p>Hello</p>');
        $checks['TR şablon marka içeriyor'] = str_contains($tr, 'Hesap360');
        $checks['EN şablon marka içeriyor'] = str_contains($en, 'Hesap360');
        $trHint = \Muh\Services\EmailTemplateService::translate('tr', 'mail.help_line', ['brand' => 'Hesap360']);
        $enHint = \Muh\Services\EmailTemplateService::translate('en', 'mail.help_line', ['brand' => 'Hesap360']);
        $checks['TR dil ayrımı (otomatik)'] = str_contains($trHint, 'otomatik') && !str_contains($trHint, 'automatically');
        $checks['EN dil ayrımı (automatically)'] = str_contains($enHint, 'automatically') && !str_contains($enHint, 'otomatik');
        $btn = \Muh\Services\EmailTemplateService::button('tr', '/x', 'Detay');
        $checks['CTA buton render'] = str_contains($btn, 'href="' . '/x' . '"') && str_contains($btn, 'Detay');
        $sub = \Muh\Services\EmailTemplateService::translate('tr', 'notify.summary_intro', ['count' => 3]);
        $checks['Yer tutucu (count)'] = str_contains($sub, '3');
        $checks['send() log modu'] = \Muh\Services\EmailTemplateService::send('tr', 'gate@example.com', 'T', '<p>x</p>');
        foreach ($checks as $n => $v) {
            echo '  [' . ($v ? 'PASS' : 'FAIL') . '] ' . $n . "\n";
            if (!$v) { $ok = false; }
        }
        echo $ok ? "Email template gate: OK\n" : "Email template gate: FAIL\n";
        exit($ok ? 0 : 1);
        break;

    case 'test:backup':
        // Focused gate (B3): backup creation + retention rotation.
        $dir = dirname(__DIR__) . '/storage/backups';
        if (!is_dir($dir)) { @mkdir($dir, 0777, true); }
        $ok = true;
        $checks = [];
        $file = (new \Muh\Database\Backup())->run();
        $checks['Yedek dosyası üretildi'] = is_file($file) && filesize($file) > 0;
        $made = [];
        for ($i = 0; $i < 3; $i++) {
            $f = $dir . '/muh-' . date('Ymd-His', time() - mt_rand(100, 9999)) . '-gate.sql';
            file_put_contents($f, '-- gate\n');
            $made[] = $f;
        }
        $pruned = \Muh\Database\Backup::prune(2);
        $after = count(glob($dir . '/muh-*.sql'));
        $checks['Rotasyon (prune>0)'] = $pruned > 0;
        $checks['Saklama sınırı (son<=2)'] = $after <= 2;
        $ping = \Muh\Database\Backup::ping();
        $checks['DB ping'] = !empty($ping['ok']);
        $checks['Liste'] = is_array(\Muh\Database\Backup::list(5));
        foreach ($made as $f) { if (is_file($f)) { @unlink($f); } }
        foreach ($checks as $n => $v) {
            echo '  [' . ($v ? 'PASS' : 'FAIL') . '] ' . $n . "\n";
            if (!$v) { $ok = false; }
        }
        echo $ok ? "Backup rotation gate: OK\n" : "Backup rotation gate: FAIL\n";
        exit($ok ? 0 : 1);
        break;

    case 'test:smtp':
        // Focused gate (#3): real SMTP client (SmtpMailer) end-to-end against a
        // local loopback SMTP relay — verifies EHLO (multiline), AUTH LOGIN,
        // MAIL/RCPT/DATA/QUIT and actual message delivery.
        // Diagnostic: surface any PHP fatal as a GitHub ::error:: annotation.
        register_shutdown_function(function () {
            $e = error_get_last();
            if ($e && in_array($e['type'], [E_ERROR, E_PARSE, E_CORE_ERROR, E_COMPILE_ERROR, E_USER_ERROR], true)) {
                fwrite(STDERR, "::error::SMTP gate fatal: {$e['message']} @ {$e['file']}:{$e['line']}\n");
            }
        });
        // Pick a free local port so the loopback relay never collides.
        $probe = @stream_socket_server('tcp://127.0.0.1:0', $err, $err2);
        $port = 2525;
        if ($probe) {
            $nm = (string) stream_socket_get_name($probe, false);
            $port = (int) substr((string) strrchr($nm, ':'), 1);
            @fclose($probe);
        }
        $tmp = sys_get_temp_dir();
        $out = $tmp . '/muh_smtp_out_' . getmypid();
        @mkdir($out, 0777, true);
        $ready = $tmp . '/muh_smtp_ready_' . getmypid();
        $log = $tmp . '/muh_smtp_log_' . getmypid() . '.txt';
        @unlink($ready); @unlink($log);

        $serverCode = <<<'SRV'
<?php
$port=(int)($argv[1]??2525); $out=$argv[2]; $ready=$argv[3]; $log=$argv[4];
function lg($m){ file_put_contents($GLOBALS['log'], $m."\n", FILE_APPEND); }
@unlink($GLOBALS['ready']);
$srv=stream_socket_server("tcp://127.0.0.1:$port",$e,$s);
if(!$srv){ lg("bind fail"); exit(1); }
file_put_contents($GLOBALS['ready'],'1');
$n=0;
while($n<2){
  $c=@stream_socket_accept($srv,15); if(!$c){ lg("accept timeout"); continue; }
  $n++; lg("accepted $n");
  stream_set_timeout($c,10);
  fwrite($c,"220 localhost ESMTP\r\n");
  $inData=false; $data='';
  $seq='';
  while(!feof($c)){
    $l=fgets($c); if($l===false){break;} $l=rtrim($l,"\r\n"); $u=strtoupper($l); $seq.=substr($l,0,16)."|";
    if($inData){ if($l==='.'){ $inData=false; fwrite($c,"250 ok\r\n"); } else { $data.=$l."\n"; } continue; }
    if(str_starts_with($u,'EHLO')){ fwrite($c,"250-localhost\r\n250 AUTH LOGIN\r\n"); }
    elseif($u==='AUTH LOGIN'){ fwrite($c,"334 VXNlcm5hbWU6\r\n"); }
    elseif($l==='YWRtaW4='){ fwrite($c,"334 UGFzc3dvcmQ6\r\n"); }
    elseif($l==='c2VjcmV0'){ fwrite($c,"235 ok\r\n"); }
    elseif(str_starts_with($u,'MAIL FROM')||str_starts_with($u,'RCPT TO')){ fwrite($c,"250 ok\r\n"); }
    elseif($u==='DATA'){ fwrite($c,"354 go\r\n"); $inData=true; }
    elseif($u==='QUIT'){ fwrite($c,"221 bye\r\n"); file_put_contents("$out/msg-$n.eml",$data); file_put_contents("$out/seq-$n.txt",$seq); break; }
    else { fwrite($c,"250 ok\r\n"); }
  }
  @fclose($c);
}
SRV;
        $serverFile = $tmp . '/muh_smtp_srv_' . getmypid() . '.php';
        file_put_contents($serverFile, $serverCode . PHP_EOL);

        $proc = null;
        $pipes = [];
        $desc = [0 => ['pipe', 'r'], 1 => ['pipe', 'w'], 2 => ['pipe', 'w']];
        $ok = true; $checks = [];
        try {
            $proc = proc_open([PHP_BINARY, $serverFile, (string) $port, $out, $ready, $log], $desc, $pipes);
            if (!is_resource($proc)) { throw new \RuntimeException('proc_open failed'); }
            // wait for the relay to bind
            $waited = 0;
            while (!file_exists($ready) && $waited < 40) { usleep(200000); $waited++; }
            $base = ['enabled' => true, 'host' => '127.0.0.1', 'port' => $port, 'encryption' => 'none', 'from' => 'NoReply <no-reply@muh.local>'];
            $r1 = (new \Muh\Services\Mailer())->send('hesap@firma.com', 'Test: vade bildirimi', '<p>Fatura vadesi yaklaşıyor.</p>', $base);
            $auth = $base; $auth['username'] = 'admin'; $auth['password'] = 'secret';
            $r2 = (new \Muh\Services\Mailer())->send('cari@example.com', 'Test: AUTH LOGIN', '<p>kimlik doğrulamalı gönderim</p>', $auth);
            $checks['Düz e-posta (no-auth)'] = $r1 === true;
            $checks['AUTH LOGIN e-posta'] = $r2 === true;
            $m1 = file_get_contents($out . '/msg-1.eml');
            $m2 = file_get_contents($out . '/msg-2.eml');
            $checks['İçerik teslimi (plain)'] = str_contains((string) $m1, 'vade bildirimi') && str_contains((string) $m1, 'Fatura vadesi yaklaşıyor');
            $checks['İçerik teslimi (auth)'] = str_contains((string) $m2, 'AUTH LOGIN') && str_contains((string) $m2, 'kimlik doğrulamalı');
            // A multiline EHLO (250-/250 AUTH LOGIN) must NOT desync the session:
            // assert the server saw a clean EHLO->MAIL->RCPT->DATA->QUIT flow.
            $s1 = (string) file_get_contents($out . '/seq-1.txt');
            $s2 = (string) file_get_contents($out . '/seq-2.txt');
            $full = $s1 . '|' . $s2;
            $checks['Çok satırlı EHLO (oturum senkron)'] =
                str_contains($full, 'EHLO muh.local')
                && substr_count($full, 'MAIL FROM') >= 2
                && substr_count($full, 'RCPT TO') >= 2
                && substr_count($full, 'DATA') >= 2
                && substr_count($full, 'QUIT') >= 2
                && $r1 === true && $r2 === true;
            // Relay sağlanamazsa ilgili kontroller zaten FAIL dönecektir.
            if (!file_exists($ready)) {
                $checks['relay başlamadı'] = false;
            }
            // Drain child stdout/stderr (non-blocking) — pipes asla dolmaz ve
            // relay hata mesajları yüzeye çıkar.
            if (is_resource($proc)) {
                stream_set_blocking($pipes[1], false);
                stream_set_blocking($pipes[2], false);
                usleep(300000);
                $childOut = (string) stream_get_contents($pipes[1]);
                $childErr = (string) stream_get_contents($pipes[2]);
                if (trim($childOut) !== '') { fwrite(STDOUT, "  [relay stdout] " . trim($childOut) . "\n"); }
                if (trim($childErr) !== '') { fwrite(STDOUT, "  [relay stderr] " . trim($childErr) . "\n"); }
            }
        } catch (\Throwable $e) {
            $checks['istisna'] = false;
            fwrite(STDERR, "  SMTP gate exception: {$e->getMessage()}\n");
            $ok = false;
        } finally {
            try {
                if (is_resource($proc)) {
                    @fclose($pipes[0]); @fclose($pipes[1]); @fclose($pipes[2]);
                    @proc_terminate($proc);
                    @proc_close($proc);
                }
            } catch (\Throwable $ignored) {
                // cleanup must never raise (uncaught => PHP exit 255) — swallow.
            }
        }
        foreach ($checks as $n => $v) {
            echo '  [' . ($v ? 'PASS' : 'FAIL') . '] ' . $n . "\n";
            if (!$v) { fwrite(STDERR, "::error::SMTP gate check failed: {$n}\n"); $ok = false; }
        }
        foreach (glob($out . '/*') ?: [] as $f) { @unlink($f); }
        @rmdir($out); @unlink($serverFile); @unlink($ready); @unlink($log);
        echo $ok ? "SMTP gate: OK\n" : "SMTP gate: FAIL\n";
        exit($ok ? 0 : 1);
        break;

    case 'test:smoke':
        // Focused gate (#5): HTTP route smoke. Probes public routes (expect 200)
        // and protected routes (expect an auth redirect) so view/route regressions
        // are caught. Accepts an optional base URL of an already-running server;
        // otherwise it starts the PHP built-in server itself.
        $httpStatus = function (string $url): int {
            $ctx = stream_context_create(['http' => ['follow_location' => false, 'timeout' => 6]]);
            @file_get_contents($url, false, $ctx);
            if (isset($http_response_header[0]) && preg_match('#^HTTP/\S+ (\d+)#', $http_response_header[0], $m)) {
                return (int) $m[1];
            }
            return 0;
        };

        $ownServer = false;
        $proc = null; $pipes = [];
        $base = $args[1] ?? '';
        if ($base === '') {
            $base = 'http://127.0.0.1:8090';
            $desc = [0 => ['pipe', 'r'], 1 => ['pipe', 'w'], 2 => ['pipe', 'w']];
            $proc = proc_open([PHP_BINARY, '-S', '127.0.0.1:8090', '-t', dirname(__DIR__) . '/public', dirname(__DIR__) . '/public/index.php'], $desc, $pipes);
            $ownServer = is_resource($proc);
            usleep(800000);
        }

        $ok = true; $checks = [];
        $public = ['/' => 200, '/pricing' => 200, '/login' => 200];
        foreach ($public as $path => $exp) {
            $code = $httpStatus($base . $path);
            $checks['GET ' . $path . ' -> ' . $exp] = $code === $exp;
            if ($code !== $exp) { $ok = false; }
        }
        foreach (['/app/audit', '/app/notifications', '/admin/audit', '/app/audit/1'] as $path) {
            $code = $httpStatus($base . $path);
            $isRedirect = in_array($code, [301, 302, 303, 307, 308], true);
            $checks['Korunan ' . $path . ' -> yönlendirme'] = $isRedirect;
            if (!$isRedirect) { $ok = false; }
        }

        // ---- Kimliği doğrulanmış uçtan uca render kontrolü (B1/B2 görünümleri) ----
        $tenantJar = tempnam(sys_get_temp_dir(), 'smk');
        $tt = function (string $method, string $path, array $post = [], bool $follow = false) use ($base, $tenantJar) {
            $ch = curl_init($base . $path);
            curl_setopt_array($ch, [CURLOPT_COOKIEJAR => $tenantJar, CURLOPT_COOKIEFILE => $tenantJar, CURLOPT_RETURNTRANSFER => true, CURLOPT_FOLLOWLOCATION => $follow, CURLOPT_CONNECTTIMEOUT => 5, CURLOPT_TIMEOUT => 15]);
            if ($method === 'POST') { curl_setopt($ch, CURLOPT_POST, true); curl_setopt($ch, CURLOPT_POSTFIELDS, http_build_query($post)); }
            $body = (string) curl_exec($ch);
            $code = (int) curl_getinfo($ch, CURLINFO_HTTP_CODE);
            curl_close($ch);
            return [$code, $body];
        };
        $tLogin = function (string $email, string $password) use ($tt): void {
            [, $b] = $tt('GET', '/login');
            preg_match('/name="_token" value="([^"]+)"/', $b, $m);
            $tt('POST', '/login', ['email' => $email, 'password' => $password, 'locale' => 'tr', '_token' => $m[1] ?? '']);
        };
        $tLogin('demo@muh.local', 'Demo1234');
        [$cN, $bN] = $tt('GET', '/app/notifications');
        [$cA, $bA] = $tt('GET', '/app/audit');
        [$cB] = $tt('GET', '/app/beyanname');
        $checkB = $cB === 200;

        // Detay sayfasının render edeceği bir audit kaydını garanti et (temiz
        // seed'de demo tenant'a ait audit olmayabilir). Sonra temizle.
        $demo = DB::first("SELECT id, tenant_id FROM users WHERE email = 'demo@muh.local' AND deleted_at IS NULL");
        $auditId = 0;
        if ($demo) {
            $auditId = (int) DB::insert('audit_logs', [
                'tenant_id' => (int) $demo['tenant_id'], 'user_id' => (int) $demo['id'],
                'module' => 'smoke', 'action' => 'smoke.render', 'entity_type' => 'test', 'entity_id' => '1',
                'old_value' => '{"a":1}', 'new_value' => '{"a":2}',
                'ip' => '127.0.0.1', 'user_agent' => 'muh-smoke',
                'created_at' => now(),
            ]);
        }
        [$cD, $bD] = $auditId > 0 ? $tt('GET', '/app/audit/' . $auditId) : [0, ''];
        $checkN = $cN === 200;
        $checkA = $cA === 200;
        $checkD = $auditId > 0 && $cD === 200 && str_contains($bD, 'smoke.render');
        if ($auditId > 0) { DB::execute('DELETE FROM audit_logs WHERE id = :id', ['id' => $auditId]); }
        $checks['tenant /app/notifications 200'] = $checkN;
        $checks['tenant /app/audit 200'] = $checkA;
        $checks['tenant /app/audit/{id} detay 200'] = $checkD;
        $checks['tenant /app/beyanname 200'] = $checkB;
        $ok = $ok && $checkN && $checkA && $checkD && $checkB;
        @unlink($tenantJar);

        $adminJar = tempnam(sys_get_temp_dir(), 'smk');
        $aa = function (string $method, string $path, array $post = [], bool $follow = false) use ($base, $adminJar) {
            $ch = curl_init($base . $path);
            curl_setopt_array($ch, [CURLOPT_COOKIEJAR => $adminJar, CURLOPT_COOKIEFILE => $adminJar, CURLOPT_RETURNTRANSFER => true, CURLOPT_FOLLOWLOCATION => $follow, CURLOPT_CONNECTTIMEOUT => 5, CURLOPT_TIMEOUT => 15]);
            if ($method === 'POST') { curl_setopt($ch, CURLOPT_POST, true); curl_setopt($ch, CURLOPT_POSTFIELDS, http_build_query($post)); }
            $body = (string) curl_exec($ch);
            $code = (int) curl_getinfo($ch, CURLINFO_HTTP_CODE);
            curl_close($ch);
            return [$code, $body];
        };
        [, $b2] = $aa('GET', '/login');
        preg_match('/name="_token" value="([^"]+)"/', $b2, $m2);
        $aa('POST', '/login', ['email' => 'admin@muh.local', 'password' => 'Admin1234!', 'locale' => 'tr', '_token' => $m2[1] ?? '']);
        [$cAdm] = $aa('GET', '/admin');
        [$cAdmAud] = $aa('GET', '/admin/audit');
        [$cExp] = $aa('GET', '/admin/audit/export?format=csv');
        $checkAdm = $cAdm === 200;
        $checkAdmAud = $cAdmAud === 200;
        $checkExp = $cExp === 200;
        $checks['süperadmin /admin 200'] = $checkAdm;
        $checks['süperadmin /admin/audit 200'] = $checkAdmAud;
        $checks['süperadmin /admin/audit/export 200'] = $checkExp;
        $ok = $ok && $checkAdm && $checkAdmAud && $checkExp;
        @unlink($adminJar);

        foreach ($checks as $n => $v) {
            echo '  [' . ($v ? 'PASS' : 'FAIL') . '] ' . $n . "\n";
        }
        if ($ownServer && is_resource($proc)) {
            try {
                @fclose($pipes[0]); @fclose($pipes[1]); @fclose($pipes[2]);
                @proc_terminate($proc);
                @proc_close($proc);
            } catch (\Throwable $ignored) {
                // cleanup must never raise (uncaught => PHP exit 255) — swallow.
            }
        }
        echo $ok ? "HTTP smoke gate: OK\n" : "HTTP smoke gate: FAIL\n";
        exit($ok ? 0 : 1);
        break;

    case 'backup':
        $file = (new \Muh\Database\Backup())->run();
        echo "Backup saved: {$file}\n";
        if (in_array('--upload', $args, true)) {
            $remote = \Muh\Database\Backup::upload($file);
            echo $remote ? "Off-box uploaded: {$remote}\n" : "Off-box: BACKUP_REMOTE_DIR not set or copy failed.\n";
        }
        // Retention: prune old backups (BACKUP_RETENTION, default 14) unless skipped.
        if (!in_array('--no-prune', $args, true)) {
            $pruned = \Muh\Database\Backup::prune();
            if ($pruned > 0) {
                echo "Retention: {$pruned} eski yedek temizlendi.\n";
            }
        }
        break;

    case 'backup:prune':
        // Prune old backups keeping the newest BACKUP_RETENTION (env, default 14).
        $keep = (int) ($args[1] ?? 0);
        $pruned = \Muh\Database\Backup::prune($keep);
        echo "Retention: {$pruned} eski yedek temizlendi.";
        if ($keep > 0) {
            echo " (son {$keep} korundu)";
        }
        echo "\n";
        break;

    case 'backup:restore':
    case 'restore':
        $backupFile = $args[1] ?? '';
        if ($backupFile === '') {
            echo "Usage: php bin/muh backup:restore <path.sql>\n";
            exit(1);
        }
        $n = \Muh\Database\Backup::restore($backupFile);
        echo $n > 0 ? "Restore ok ({$n} statement group executed).\n" : "Restore: nothing executed (check mysql client / file).\n";
        break;

    case 'key:generate':
        // Generate a random base64 key (used for APP_KEY in .env).
        $key = 'base64:' . base64_encode(random_bytes(32));
        echo "$key\n";
        echo "APP_KEY=$key\n";
        break;

    case 'admin:make':
        // Promote (or find) a user by e-mail to super admin. Owner-level action.
        $email = strtolower(trim($args[1] ?? ''));
        if ($email === '') {
            echo "Usage: php bin/muh admin:make <email>\n";
            exit(1);
        }
        $user = DB::first('SELECT id, name, is_system_admin FROM users WHERE email = :e AND deleted_at IS NULL', ['e' => $email]);
        if (!$user) {
            echo "No user found with e-mail: {$email}\n";
            exit(1);
        }
        if ($user['is_system_admin']) {
            echo "Already a super admin: {$email}\n";
        } else {
            DB::execute('UPDATE users SET is_system_admin = 1, updated_at = :n WHERE id = :id', ['n' => now(), 'id' => (int) $user['id']]);
            echo "Promoted to super admin: {$email} ({$user['name']})\n";
        }
        break;

    case 'company:demo':
        // Mark/unmark a company as demo (sample) data. Usage: php bin/muh company:demo <id> [0|1]
        $companyId = (int) ($args[1] ?? 0);
        $on = ($args[2] ?? '1') !== '0';
        if ($companyId <= 0) {
            echo "Usage: php bin/muh company:demo <company_id> [0|1]\n";
            exit(1);
        }
        $co = DB::first('SELECT id, name FROM companies WHERE id = :id AND deleted_at IS NULL', ['id' => $companyId]);
        if (!$co) {
            echo "Company not found: {$companyId}\n";
            exit(1);
        }
        DB::execute('UPDATE companies SET is_demo = :d, updated_at = :n WHERE id = :id', ['d' => (int) $on, 'n' => now(), 'id' => $companyId]);
        echo "Company #{$companyId} ({$co['name']}) " . ($on ? 'demo olarak işaretlendi' : 'demo olmaktan çıkarıldı') . ".\n";
        break;

    case 'reminders':
    case 'reminder:run':
        // Send due/unpaid invoice reminder e-mails for every tenant.
        $tenants = DB::select('SELECT id FROM tenants WHERE status = \'active\'');
        $svc = new \Muh\Services\InvoiceReminderService();
        $totalSent = 0;
        $totalInvoices = 0;
        foreach ($tenants as $tenant) {
            $res = $svc->sendReminders((int) $tenant['id'], 7);
            $totalSent += $res['sent'];
            $totalInvoices += $res['invoices'];
        }
        echo "Reminders sent: {$totalSent} e-mails across {$totalInvoices} due invoice(s).\n";
        break;

    case 'notifications':
    case 'notify:run':
        // Generate automatic notifications (due invoices, critical stock...) for every active tenant.
        $tenants = DB::select("SELECT id FROM tenants WHERE status = 'active'");
        $svc = new \Muh\Services\NotificationService();
        $total = 0;
        foreach ($tenants as $tenant) {
            $total += $svc->generate((int) $tenant['id']);
        }
        echo "Notifications generated: {$total}\n";
        break;

    case 'notify:summary':
    case 'summary:send':
        // Daily e-mail digest: send a localized summary of each active tenant's
        // notifications when the `notify_daily_summary` mail setting is on.
        // Intended to run via cron once a day. Usage: php bin/muh notify:summary
        $tenants = DB::select("SELECT id FROM tenants WHERE status = 'active'");
        $sent = 0;
        foreach ($tenants as $tenant) {
            if (\Muh\Services\NotificationService::sendDailySummary((int) $tenant['id'])) {
                $sent++;
            }
        }
        echo "Daily e-mail summaries sent: {$sent} tenant(s).\n";
        break;

    case 'beyanname:send':
        // e-Beyan (Faz 1): her aktif tenant'in draft/packaged/error beyannamelerini
        // tenant'in GİB gateway'i üzerinden gönderir.
        $tenants = DB::select("SELECT id FROM tenants WHERE status = 'active'");
        $submitted = 0; $failed = 0;
        foreach ($tenants as $tenant) {
            $rows = DB::select(
                "SELECT id FROM beyannameler WHERE tenant_id = :t AND status IN ('draft','packaged','error') ORDER BY id",
                ['t' => (int) $tenant['id']]
            );
            foreach ($rows as $r) {
                $res = \Muh\Services\BeyannameService::submit((int) $r['id'], (int) $tenant['id']);
                $res['ok'] ? $submitted++ : $failed++;
                echo "  beyanname #{$r['id']}: " . ($res['ok'] ? 'sent' : 'failed') . " — " . $res['message'] . ($res['reference'] ? " ({$res['reference']})" : '') . "\n";
            }
        }
        echo "e-Beyan gönderim: {$submitted} gönderildi, {$failed} hata.\n";
        break;

    case 'efatura:poll':
        // Query e-Fatura statuses (sending/sent) for every active tenant via the
        // configured gateway (simulated or real REST integrator).
        $tenants = DB::select("SELECT id FROM tenants WHERE status = 'active'");
        $svc = new \Muh\Services\EFaturaService();
        $advanced = 0;
        foreach ($tenants as $tenant) {
            foreach ($svc->pollForTenant((int) $tenant['id']) as $r) {
                $advanced++;
                echo "  invoice #{$r['id']}: {$r['from']} -> {$r['to']}\n";
            }
        }
        echo "e-Fatura statuses polled; {$advanced} invoice(s) advanced.\n";
        break;

    case 'doctor':
    case 'ready':
        // Production-readiness self-check (no deployment performed).
        $checks = [];
        $add = function (string $name, bool $ok, string $detail = '') use (&$checks) {
            $checks[] = ['name' => $name, 'ok' => $ok, 'detail' => $detail];
        };

        // 1) Environment
        $env = config('app.env', 'local');
        $add('Uygulama ortamı (APP_ENV)', $env !== 'local', "env={$env}");

        // 2) Maintenance
        $maint = (bool) config('app.maintenance', false);
        $add('Bakım modu kapalı', !$maint, $maint ? 'bakım modu AÇIK' : 'kapalı');

        // 3) HTTPS / secure session (production)
        $secure = (bool) config('app.session.secure', false);
        $add('Güvenli oturum (SESSION_SECURE)', !$secure ? false : true, 'SESSION_SECURE=' . ($secure ? 'true' : 'false (production için true önerilir)'));

        // 4) Rate limiting
        $rl = (bool) config('app.security.rate_limit.enabled', true);
        $add('Rate limit etkin', $rl, $rl ? 'etkin' : 'kapalı');

        // 5) Performans indeksleri
        try {
            $idx = (int) DB::scalar(
                "SELECT COUNT(*) FROM information_schema.STATISTICS
                  WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'notifications' AND INDEX_NAME = 'idx_notif_tenant_read'"
            );
            $add('Performans indeksleri (migration 0018)', $idx >= 1, $idx >= 1 ? 'mevcut' : 'php bin/muh migrate çalıştır');
        } catch (\Throwable $e) {
            $add('Performans indeksleri', false, $e->getMessage());
        }

        // 6) Storage writable + backups dir
        $docs = rtrim((string) config('app.filesystem.documents', dirname(__DIR__) . '/storage/documents'), '/');
        $bkDir = dirname(__DIR__) . '/storage/backups';
        $wDocs = is_dir($docs) ? is_writable($docs) : (is_writable(dirname($docs)));
        $wBk = is_dir($bkDir) ? is_writable($bkDir) : (is_writable(dirname($bkDir)));
        $add('Storage yazılabilir (belgeler)', $wDocs, $docs);
        $add('Yedekleme klasörü yazılabilir', $wBk, $bkDir);

        $fails = 0;
        foreach ($checks as $c) {
            $mark = $c['ok'] ? 'PASS' : ($env === 'production' ? 'FAIL' : 'WARN');
            if (!$c['ok'] && ($env === 'production')) {
                $fails++;
            }
            echo "  [{$mark}] {$c['name']} — {$c['detail']}\n";
        }
        echo "\nReadiness summary: " . (count($checks) - $fails) . "/" . count($checks) . " ok\n";
        if ($env === 'production') {
            exit($fails > 0 ? 1 : 0);
        }
        break;

    case 'security':
        exit((new \Muh\Core\SecurityChecker())->run());

    case 'test-db':
        echo "Driver: " . DB::driver() . "\n";
        break;

    case 'i18n:check':
        // Translation completeness check: report tr/en key differences and any
        // __('...') keys used in code that are missing from both language files.
        $langDir = dirname(__DIR__) . '/resources/lang';
        $load = function (string $dir) {
            $keys = [];
            foreach (glob($dir . '/*.php') as $file) {
                $base = basename($file, '.php');
                foreach ((array) include $file as $k => $v) {
                    $keys[$base . '.' . $k] = $v;
                }
            }
            return $keys;
        };
        $tr = $load($langDir . '/tr');
        $en = $load($langDir . '/en');
        $missingEn = array_diff_key($tr, $en);
        $missingTr = array_diff_key($en, $tr);

        // Scan source for __('key') / __('key', [...]) usages.
        $used = [];
        $scanDir = dirname(__DIR__) . '/app';
        $it = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($scanDir));
        foreach ($it as $f) {
            if (!$f->isFile() || substr($f->getFilename(), -4) !== '.php') {
                continue;
            }
            $c = (string) file_get_contents($f->getPathname());
            if (preg_match_all("/__\s*\(\s*'([^']+)'\)/", $c, $m)) {
                foreach ($m[1] as $key) {
                    $used[$key] = true;
                }
            }
        }
        $unknown = [];
        foreach (array_keys($used) as $key) {
            if (!isset($tr[$key]) && !isset($en[$key])) {
                $unknown[$key] = true;
            }
        }

        $fails = 0;
        echo "TR/EN anahtar farkı:\n";
        if (!$missingEn && !$missingTr) {
            echo "  [OK] tr ve en anahtar kümeleri eşit (" . count($tr) . " anahtar).\n";
        } else {
            foreach ($missingEn as $k => $v) {
                $fails++;
                echo "  [FAIL] en eksik: {$k}\n";
            }
            foreach ($missingTr as $k => $v) {
                $fails++;
                echo "  [FAIL] tr eksik: {$k}\n";
            }
        }
        echo "Tanımsız __() anahtarları:\n";
        if (!$unknown) {
            echo "  [OK] kodda tanımsız `__()` anahtarı yok (" . count($used) . " kullanım denetlendi).\n";
        } else {
            foreach (array_keys($unknown) as $k) {
                $fails++;
                echo "  [FAIL] tanımsız: {$k}\n";
            }
        }
        echo "\nToplam " . count($tr) . " (tr) / " . count($en) . " (en) anahtar; {$fails} sorun.\n";
        exit($fails > 0 ? 1 : 0);
        break;

    default:
        echo "MUH CLI\n";
        echo "  php bin/muh migrate [--fresh]\n";
        echo "  php bin/muh seed\n";
        echo "  php bin/muh drop\n";
}
