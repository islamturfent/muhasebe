# Production .env example — copy relevant values into your real .env
# IMPORTANT: never commit the real .env with secrets to version control.

APP_ENV=production
APP_DEBUG=false
APP_MAINTENANCE=false
APP_URL=https://muhaccounting.example.com
APP_HTTPS=true
APP_KEY=base64:PASTE-RANDOM-KEY-FROM-php-bin-muh-key:generate

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=muh
DB_USERNAME=muh_app
DB_PASSWORD=STRONG-DB-PASSWORD

PASSWORD_MIN_LENGTH=8

BILLING_PROVIDER=simulated
BILLING_WEBHOOK_SECRET=STRONG-RANDOM-SECRET

SESSION_SECURE=true

EFATURA_PROVIDER=simulated
EFATURA_MODE=test
EFATURA_USERNAME=
EFATURA_PASSWORD=

# Off-box backup dir (mount/network drive). Used by `php bin/muh backup --upload`.
BACKUP_REMOTE_DIR=
# Retention: keep only the newest N backups (pruned automatically on `backup`).
BACKUP_RETENTION=14
